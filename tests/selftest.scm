; ---------- §7 递归：用语言本身定义 map / filter ----------
(define (my-map f xs)
  (if (null? xs) '() (cons (f (car xs)) (my-map f (cdr xs)))))
(check "map"        (my-map (lambda (x) (* x x)) '(1 2 3 4)) '(1 4 9 16))
(check "map-nil"    (my-map car '()) '())
(define (my-filter p xs)
  (cond ((null? xs) '())
        ((p (car xs)) (cons (car xs) (my-filter p (cdr xs))))
        (else (my-filter p (cdr xs)))))
(check "filter"     (my-filter even? '(1 2 3 4 5 6)) '(2 4 6))
(check "filter-all" (my-filter odd? '(2 4)) '())
(define (my-reduce f init xs)
  (if (null? xs) init (my-reduce f (f init (car xs)) (cdr xs))))
(check "reduce"     (my-reduce + 0 '(1 2 3 4)) 10)
(define (fact n) (if (= n 0) 1 (* n (fact (- n 1)))))
(check "fact"       (fact 10) 3628800)
(define (fib n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(check "fib"        (fib 15) 610)
(define (sum-to n) (if (= n 0) 0 (+ n (sum-to (- n 1)))))
(check "sum-to"     (sum-to 100) 5050)
(define (deep n) (if (= n 0) 0 (deep (- n 1))))
(check "deep-rec"   (deep 5000) 0)

